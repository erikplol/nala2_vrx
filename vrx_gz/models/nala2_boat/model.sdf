      </axis>
      <parent>base_link</parent>
      <child>stern_left_housing_link</child>
    </joint>

    <!-- Stern-left housing-propeller joint -->
    <joint name="stern_left_engine_propeller_joint" type="revolute">
      <pose>0 0 0 1.5708 0.0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>100</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <friction>0.05</friction>
          <damping>0.05</damping>
        </dynamics>
      </axis>
      <parent>stern_left_housing_link</parent>
      <child>stern_left_prop_link</child>
    </joint>

    <!-- Stern-right chassis-housing joint -->
    <joint name="stern_right_chasis_engine_joint" type="revolute">
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159</lower>
          <upper>3.14159</upper>
          <effort>100</effort>
          <velocity>10</velocity>
        </limit>
        <dynamics>
          <damping>1.0</damping>
          <friction>0.1</friction>
        </dynamics>
      </axis>
      <parent>base_link</parent>
      <child>stern_right_housing_link</child>
    </joint>

    <!-- Stern-right housing-propeller joint -->
    <joint name="stern_right_engine_propeller_joint" type="revolute">
      <pose>0 0 0 1.5708 0.0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>100</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <friction>0.05</friction>
          <damping>0.05</damping>
        </dynamics>
      </axis>
      <parent>stern_right_housing_link</parent>
      <child>stern_right_prop_link</child>
    </joint>

    <!-- Bow-left chassis-housing joint (fixed at 45 degrees) -->
    <joint name="bow_left_chasis_engine_joint" type="fixed">
      <parent>base_link</parent>
      <child>bow_left_housing_link</child>
    </joint>

    <!-- Bow-left housing-propeller joint -->
    <joint name="bow_left_engine_propeller_joint" type="revolute">
      <pose>0 0 0 1.5708 0.0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>100</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <friction>0.05</friction>
          <damping>0.05</damping>
        </dynamics>
      </axis>
      <parent>bow_left_housing_link</parent>
      <child>bow_left_prop_link</child>
    </joint>

    <!-- Bow-right chassis-housing joint (fixed at -45 degrees) -->
    <joint name="bow_right_chasis_engine_joint" type="fixed">
      <parent>base_link</parent>
      <child>bow_right_housing_link</child>
    </joint>

    <!-- Bow-right housing-propeller joint -->
    <joint name="bow_right_engine_propeller_joint" type="revolute">
      <pose>0 0 0 1.5708 0.0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>100</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <friction>0.05</friction>
          <damping>0.05</damping>
        </dynamics>
      </axis>
      <parent>bow_right_housing_link</parent>
      <child>bow_right_prop_link</child>
    </joint>

    <!-- Left hull -->
    <plugin
      filename="libSurface.so"
      name="vrx::Surface">
      <link_name>base_link</link_name>
      <hull_length>1.15</hull_length>
      <hull_radius>0.12</hull_radius>
      <fluid_level>0</fluid_level>
      <points>
        <point>0.68 0.314338 0.0352701</point>
        <point>-0.465 0.314338 0.0352701</point>
      </points>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>

    <!-- Right hull -->
    <plugin
      filename="libSurface.so"
      name="vrx::Surface">
      <link_name>base_link</link_name>
      <hull_length>1.15</hull_length>
      <hull_radius>0.12</hull_radius>
      <fluid_level>0</fluid_level>
      <points>
        <point>0.68 -0.314338 0.0352701</point>
        <point>-0.465 -0.314338 0.0352701</point>
      </points>
      <wavefield>
        <topic>/vrx/wavefield/parameters</topic>
      </wavefield>
    </plugin>

    <plugin
      filename="libSimpleHydrodynamics.so"
      name="vrx::SimpleHydrodynamics">
      <link_name>base_link</link_name>
      <!-- Added mass -->
      <xDotU>0.0</xDotU>
      <yDotV>0.0</yDotV>
      <nDotR>0.0</nDotR>
      <!-- Linear and quadratic drag -->
      <xU>2.0</xU>
      <xUU>3.0</xUU>
      <yV>0.5</yV>
      <yVV>0.5</yVV>
      <zW>20.0</zW>
      <kP>5.0</kP>
      <kPP>10.0</kPP>
      <mQ>10.0</mQ>
      <mQQ>10.0</mQQ>
      <nR>3.0</nR>
      <nRR>3.0</nRR>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>model</namespace>
      <joint_name>stern_left_engine_propeller_joint</joint_name>
      <thrust_coefficient>0.004</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <topic>nala2_boat/joint/stern_left_engine_propeller_joint/cmd_thrust</topic>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>model</namespace>
      <joint_name>stern_right_engine_propeller_joint</joint_name>
      <thrust_coefficient>0.004</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <topic>nala2_boat/joint/stern_right_engine_propeller_joint/cmd_thrust</topic>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>model</namespace>
      <joint_name>bow_left_engine_propeller_joint</joint_name>
      <thrust_coefficient>0.004</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <topic>nala2_boat/joint/bow_left_engine_propeller_joint/cmd_thrust</topic>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>model</namespace>
      <joint_name>bow_right_engine_propeller_joint</joint_name>
      <thrust_coefficient>0.004</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <topic>nala2_boat/joint/bow_right_engine_propeller_joint/cmd_thrust</topic>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>stern_left_chasis_engine_joint</joint_name>
      <topic>/model/nala2_boat/joint/stern_left_chasis_engine_joint/rotate_angle</topic>
      <p_gain>15</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>1</d_gain>
    </plugin>
  
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>stern_right_chasis_engine_joint</joint_name>
      <topic>/model/nala2_boat/joint/stern_right_chasis_engine_joint/rotate_angle</topic>
      <p_gain>15</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>1</d_gain>
    </plugin>

  </model>
</sdf>
